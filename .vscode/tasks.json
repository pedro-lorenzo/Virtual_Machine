{
    "tasks": [
        {
            "type": "process",
            "label": "Compilar máquina virtual",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-I",
                "${workspaceFolder}\\Headers",
                "${workspaceFolder}\\src\\cc.c",
                "${workspaceFolder}\\src\\funciones.c",
                "${workspaceFolder}\\src\\instrucciones.c",
                "${workspaceFolder}\\src\\lectura.c",
                "${workspaceFolder}\\src\\procesador.c",
                "-o",
                "${workspaceFolder}\\vm.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila todos los archivos C y busca headers en Headers."
        }
    ],
    "version": "2.0.0"
}
